# Copy to Agent_Firewall/.env and fill in. Never commit the real file.

# Upstream LLM providers
OPENROUTER_KEY=
GROQ_API_KEY=

# Database (defaults to local SQLite when unset)
DATABASE_URL=

# Admin token for the dashboard and management APIs.
# If unset, a random token is generated at startup and printed to the server log.
FIREWALL_ADMIN_TOKEN=

# Comma-separated origins allowed to call the API from a browser (default: same-origin only)
FIREWALL_CORS_ORIGINS=

# Prompt-injection classifier for tool/RAG content: auto | hf | none
#   auto: use the Hugging Face model if transformers+torch are installed, else rules only
INJECTION_CLASSIFIER=auto
